    syslog_server:
      host: 10.5.11.222
    features:
      version_update:
        current_version: "9.2.13.211102"
        # This VSNS does not get list of available updates from update server.
        next_version: ""
        latest_version: ""
        can_be_applied: False
        old_update_status_present: False
      virtual_disk:
        is_supported: True
